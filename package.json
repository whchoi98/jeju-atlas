{
  "name": "jeju-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/server.mjs",
    "check": "node scripts/check.mjs",
    "workshop:build": "node workshop/scripts/build.mjs",
    "workshop:check": "node workshop/scripts/check.mjs",
    "workshop:package": "npm run workshop:build && python3 workshop/scripts/package_handbook.py"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1128.0",
    "@aws-sdk/client-dynamodb": "3.1128.0",
    "@aws-sdk/client-s3": "3.1128.0"
  },
  "devDependencies": {
    "maplibre-gl": "6.9.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=24.18.1"
  }
}
