# Enter real values with workshop_env.py configure in your own Bash terminal.
# The generated file is workshop/.local/labs/<participant>/.env (mode 0600),
# outside app/JejuGuide and deployment archives. Never source or print it.
# Model call region: issuing region for a short-term key, an allowed region for a long-term key.
ATLAS_BEDROCK_REGION=
# Bedrock short-term or long-term API key; deployment still uses the EC2 IAM role.
AWS_BEARER_TOKEN_BEDROCK=

# Optional after the basic Runtime deployment:
KAKAO_REST_API_KEY=
TOURAPI_SERVICE_KEY=
VISIT_JEJU_API_KEY=
