FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk upgrade --no-cache \
    && apk add --no-cache python3=3.14.7-r1 py3-boto3=1.43.6-r0 py3-requests=2.33.1-r0 ca-certificates \
    && addgroup -g 1000 -S collector \
    && adduser -S -D -H -u 1000 -G collector collector
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --chown=collector:collector scripts/fetch-place-details.py scripts/place_detail_sources.py ./
# Preserve writable permissions when ECS initializes the ephemeral work volume.
RUN chmod 1777 /tmp
VOLUME ["/tmp"]
USER 1000:1000
ENTRYPOINT ["python3", "/app/fetch-place-details.py", "--publish"]
