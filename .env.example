# Local API server. Copy to .env and run:
# node --env-file=.env server/server.mjs
# Start the frontend separately with npm run dev.
NODE_ENV=development
HOST=127.0.0.1
PORT=8097
PUBLIC_ORIGIN=http://localhost:5173
AWS_REGION=ap-northeast-2

# The SQLite catalog is local data and is not included in Git.
# Prepare a catalog file or replace this with your own readable S3 bucket.
CATALOG_LOCAL_PATH=.local/catalog-standalone.sqlite
# CATALOG_BUCKET=your-catalog-bucket
# DETAILS_BUCKET=your-details-bucket

# Optional: your local Valhalla service and its actual source timestamp.
# ROUTING_URL=http://127.0.0.1:8002
# ROUTING_DATA_UPDATED_AT=YYYY-MM-DDTHH:mm:ssZ

# AI is optional. Configure the owned Runtime, quota table and session signing
# secret through the existing deployment flow; never commit secret values here.
